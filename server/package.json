{
  "name": "breakfast-order-server",
  "version": "0.1.0",
  "private": true,
  "description": "早餐店扫码点餐系统 - 后端 API",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
