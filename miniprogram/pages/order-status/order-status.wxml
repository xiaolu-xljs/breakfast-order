<view class="page" wx:if="{{order}}">
  <view class="hero">
    <view class="hero-icon">{{stepIndex >= 2 ? '✅' : '⏳'}}</view>
    <view class="hero-title">{{statusText}}</view>
    <view class="hero-sub">订单号 {{order.orderNo}} · 桌号 {{order.tableNo}}</view>
  </view>

  <view class="timeline">
    <view class="step {{stepIndex >= 0 ? 'done' : ''}}">
      <view class="dot">1</view>
      <text>已下单</text>
    </view>
    <view class="line {{stepIndex >= 1 ? 'done' : ''}}"></view>
    <view class="step {{stepIndex >= 1 ? 'done' : ''}}">
      <view class="dot">2</view>
      <text>制作中</text>
    </view>
    <view class="line {{stepIndex >= 2 ? 'done' : ''}}"></view>
    <view class="step {{stepIndex >= 2 ? 'done' : ''}}">
      <view class="dot">3</view>
      <text>已出餐</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">商品明细</view>
    <view wx:for="{{order.items}}" wx:key="productName" class="item">
      <text class="name">{{item.productName}}</text>
      <text class="qty">× {{item.quantity}}</text>
      <text class="money">¥{{item.subtotal}}</text>
    </view>
    <view class="total">
      <text>合计</text>
      <text class="money">¥{{order.totalAmount}}</text>
    </view>
  </view>

  <view class="footer">
    <button class="btn-ghost" bindtap="callWaiter">呼叫服务员</button>
    <button class="btn-primary" bindtap="reorder">再来一单</button>
  </view>
</view>