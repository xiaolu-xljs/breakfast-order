.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.topbar {
  background: #ff6b35;
  color: #fff;
  padding: 16px;
  font-size: 16px;
  font-weight: 600;
}
.badge {
  background: rgba(255, 255, 255, 0.25);
  padding: 2px 10px;
  border-radius: 12px;
  font-size: 13px;
  margin-left: 4px;
}
.body {
  flex: 1;
  display: flex;
  overflow: hidden;
}
.categories {
  width: 96px;
  background: #f5f6f8;
}
.category {
  padding: 18px 12px;
  font-size: 14px;
  color: #333;
  border-left: 3px solid transparent;
}
.category.active {
  background: #fff;
  color: #ff6b35;
  border-left-color: #ff6b35;
  font-weight: 600;
}
.products {
  flex: 1;
  background: #fff;
  padding: 12px;
}
.empty {
  text-align: center;
  color: #909399;
  padding: 60px 0;
}
.product {
  display: flex;
  padding: 12px 0;
  border-bottom: 1px solid #f0f0f0;
  align-items: center;
}
.image {
  width: 70px;
  height: 70px;
  border-radius: 8px;
  background: #f5f5f5;
  margin-right: 12px;
}
.image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
}
.info {
  flex: 1;
}
.name {
  font-size: 15px;
  font-weight: 500;
}
.desc {
  color: #909399;
  font-size: 12px;
  margin-top: 2px;
}
.money {
  color: #ff6b35;
  font-weight: 600;
  margin-top: 4px;
}
.actions {
  display: flex;
  align-items: center;
  gap: 8px;
}
.btn-minus, .btn-plus {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: #ff6b35;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
}
.qty {
  min-width: 20px;
  text-align: center;
  font-size: 14px;
}

.cart-bar {
  height: 56px;
  background: #2c2c2c;
  color: #fff;
  display: flex;
  align-items: center;
  padding: 0 16px;
  position: relative;
}
.cart-icon {
  font-size: 22px;
}
.cart-count {
  background: #ff3b30;
  color: #fff;
  border-radius: 10px;
  padding: 0 6px;
  font-size: 11px;
  margin-left: -6px;
  margin-top: -10px;
}
.cart-total {
  flex: 1;
  margin-left: 16px;
  font-size: 16px;
  font-weight: 600;
}
.go-confirm {
  background: #ff6b35;
  padding: 8px 18px;
  border-radius: 20px;
  font-size: 14px;
}

.cart-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 99;
}
.cart-panel {
  background: #fff;
  width: 100%;
  height: 60%;
  border-top-left-radius: 16px;
  border-top-right-radius: 16px;
  display: flex;
  flex-direction: column;
}
.cart-header {
  padding: 16px;
  display: flex;
  justify-content: space-between;
  border-bottom: 1px solid #f0f0f0;
  font-weight: 600;
}
.cart-header .close {
  font-size: 18px;
  color: #909399;
}
.cart-list {
  flex: 1;
  padding: 8px 16px;
}
.cart-item {
  display: flex;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #f5f5f5;
}
.cart-name {
  flex: 1;
}
.cart-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}
.cart-footer {
  padding: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid #f0f0f0;
  font-size: 16px;
  font-weight: 600;
}