.page {
  padding: 16px;
  padding-bottom: 100px;
}
.section {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
}
.section-title {
  color: #909399;
  font-size: 13px;
  margin-bottom: 12px;
}
.table-no {
  font-size: 20px;
  font-weight: 600;
  color: #ff6b35;
}
.item {
  display: flex;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px dashed #f0f0f0;
}
.item:last-child {
  border-bottom: none;
}
.item .name {
  flex: 1;
  font-size: 15px;
}
.item .qty {
  color: #909399;
  margin: 0 12px;
}
.item .money {
  color: #ff6b35;
  font-weight: 600;
}
.total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 16px;
  font-weight: 600;
}
.total-money {
  font-size: 22px;
}
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16px;
  background: #fff;
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.05);
}
.btn-submit {
  background: #ff6b35;
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  border-radius: 24px;
}